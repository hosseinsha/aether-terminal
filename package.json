{
  "name": "aether-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run format:check && npm test",
    "format": "prettier --write \"app/src/*.js\" \"app/tests/**/*.js\" eslint.config.js package.json",
    "format:check": "prettier --check \"app/src/*.js\" \"app/tests/**/*.js\" eslint.config.js package.json",
    "lint": "eslint \"app/src/**/*.js\" \"app/tests/**/*.js\" eslint.config.js",
    "test": "node --test app/tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "eslint": "^8.57.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
